{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maia Studio",
  "version": "0.1.0",
  "identifier": "com.gaong.maia.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Maia Studio — Human Chess Intelligence",
      "width": 1510,
      "height": 940,
      "minWidth": 1030,
      "minHeight": 700,
      "backgroundColor": "#0b1019"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Maia3-79M analysis GUI",
    "category": "Education"
  }
}
